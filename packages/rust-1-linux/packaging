#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEBUG:=}" != "" ]]; then
  set -x
fi

# Install the toolchain matching the compile VM's architecture.
case "$(uname -m)" in
  x86_64)        rust_arch="x86_64" ;;
  aarch64|arm64) rust_arch="aarch64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

tar xzf rust-*-"${rust_arch}"-unknown-linux-gnu.tar.gz

pushd rust-*-"${rust_arch}"-unknown-linux-gnu || exit 1
  ./install.sh \
    --prefix="${BOSH_INSTALL_TARGET}" \
    --without=rust-docs \
    --disable-ldconfig
popd

mkdir "${BOSH_INSTALL_TARGET}/bosh"

PACKAGE_NAME="$(basename "${BOSH_INSTALL_TARGET}")"
export PACKAGE_NAME
sed "s#\${PACKAGE_NAME}#${PACKAGE_NAME}#" compile.env > "${BOSH_INSTALL_TARGET}/bosh/compile.env"
sed "s#\${PACKAGE_NAME}#${PACKAGE_NAME}#" runtime.env > "${BOSH_INSTALL_TARGET}/bosh/runtime.env"
